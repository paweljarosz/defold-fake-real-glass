#version 140

// Positions can be world or local space, since world and normal
// matrices are identity for world vertex space materials.
// If world vertex space is selected, you can remove the
// normal matrix multiplication for optimal performance.

in highp vec4 position;
in mediump vec2 texcoord0;
in mediump vec3 normal;

// When 'mtx_world' and 'mtx_normal' is specified as attributes,
// instanced rendering is automatically triggered.
// To read more about instancing in Defold, navigate to
// https://defold.com/manuals/material/#instancing
in highp mat4 mtx_world;
in mediump mat4 mtx_normal;

out highp vec4 var_position;
out mediump vec3 var_normal;
out mediump vec2 var_texcoord0;
out highp mat4 var_view;
out vec3 var_world_pos;
out vec4 var_reflection_clip;

uniform vs_uniforms
{
    mediump mat4 mtx_view;
    mediump mat4 mtx_proj;
    mat4 reflection_view_proj;
};

void main()
{
    vec4 p = mtx_view * mtx_world * vec4(position.xyz, 1.0);
    var_view = mtx_view;
    var_world_pos = (mtx_world * vec4(position.xyz, 1.0)).xyz;
    var_reflection_clip = reflection_view_proj * vec4(var_world_pos, 1.0);
    var_position = p;
    var_texcoord0 = texcoord0;
    // Defold supplies inverse-transpose(view * world) for this attribute.
    // The normal is already in view space, as expected by diffuse_lambert.
    var_normal = normalize((mtx_normal * vec4(normal, 0.0)).xyz);
    gl_Position = mtx_proj * p;
}
