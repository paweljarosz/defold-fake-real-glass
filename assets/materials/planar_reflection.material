name: "planar_reflection"
tags: "planar_reflection"
vertex_program: "/assets/materials/planar_reflection.vp"
fragment_program: "/assets/materials/planar_reflection.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants {
  name: "mtx_view"
  type: CONSTANT_TYPE_VIEW
}
vertex_constants {
  name: "mtx_proj"
  type: CONSTANT_TYPE_PROJECTION
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
vertex_constants { name: "reflection_view_proj" type: CONSTANT_TYPE_USER_MATRIX4 }
fragment_constants {
  name: "reflection_params"
  type: CONSTANT_TYPE_USER
  value { z: 0.3 }
}
samplers {
  name: "planar_reflection"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}

fragment_constants { name: "reflection_surface" type: CONSTANT_TYPE_USER value { x: 2.5 y: 0.35 z: 8.0 w: 24.0 } }
fragment_constants { name: "reflection_fade" type: CONSTANT_TYPE_USER value { z: 1.0 } }
