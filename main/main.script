function init(self)
    msg.post("camera", "acquire_camera_focus")
    msg.post("@render:", "enable_planar_reflection", { enabled = true })
    go.set("/plane#quad", "tint", vmath.vector4(0.055, 0.065, 0.08, 1))
    msg.post("@render:", "clear_color", { color = vmath.vector4(0.002, 0.003, 0.005, 1) })
    msg.post("@render:", "enable_shared_glass", { enabled = false })
end

function update(self, dt)
    for _, side in ipairs({ "left", "right" }) do
        msg.post("@render:", "set_sphere_probe", {
            tag = "glass_sphere_" .. side,
            position = go.get_world_position("/glass_sphere_" .. side),
        })
    end
end
