local fake_real_glass = require "fake_real_glass.fake_real_glass"

--
-- message constants
--
local MSG_CLEAR_COLOR =         hash("clear_color")
local MSG_WINDOW_RESIZED =      hash("window_resized")
local MSG_SET_VIEW_PROJ =       hash("set_view_projection")
local MSG_SET_CAMERA_PROJ =     hash("use_camera_projection")
local MSG_USE_STRETCH_PROJ =    hash("use_stretch_projection")
local MSG_USE_FIXED_PROJ =      hash("use_fixed_projection")
local MSG_USE_FIXED_FIT_PROJ =  hash("use_fixed_fit_projection")

local DEFAULT_NEAR = -1
local DEFAULT_FAR =   1
local DEFAULT_ZOOM =  1

--
-- projection that centers content with maintained aspect ratio and optional zoom
--
local function get_fixed_projection(camera, state)
    camera.zoom = camera.zoom or DEFAULT_ZOOM
    local projected_width = state.window_width / camera.zoom
    local projected_height = state.window_height / camera.zoom
    local left = -(projected_width - state.width) / 2
    local bottom = -(projected_height - state.height) / 2
    local right = left + projected_width
    local top = bottom + projected_height
    return vmath.matrix4_orthographic(left, right, bottom, top, camera.near, camera.far)
end
--
-- projection that centers and fits content with maintained aspect ratio
--
local function get_fixed_fit_projection(camera, state)
    camera.zoom = math.min(state.window_width / state.width, state.window_height / state.height)
    return get_fixed_projection(camera, state)
end
--
-- projection that stretches content
--
local function get_stretch_projection(camera, state)
    return vmath.matrix4_orthographic(0, state.width, 0, state.height, camera.near, camera.far)
end
--
-- projection for gui
--
local function get_gui_projection(camera, state)
    return vmath.matrix4_orthographic(0, state.window_width, 0, state.window_height, camera.near, camera.far)
end

local function update_clear_color(state, color)
    if color then
        state.clear_buffers[graphics.BUFFER_TYPE_COLOR0_BIT] = color
    end
end

local function update_camera(camera, state)
    if camera.projection_fn then
        camera.proj = camera.projection_fn(camera, state)
        camera.options.frustum = camera.proj * camera.view
    end
end

local function update_state(state)
    state.window_width = render.get_window_width()
    state.window_height = render.get_window_height()
    state.valid = state.window_width > 0 and state.window_height > 0
    if not state.valid then
        return false
    end
    -- Make sure state updated only once when resize window
    if state.window_width == state.prev_window_width and state.window_height == state.prev_window_height then
        return true
    end
    state.prev_window_width = state.window_width
    state.prev_window_height = state.window_height
    state.width = render.get_width()
    state.height = render.get_height()
    for _, camera in pairs(state.cameras) do
        update_camera(camera, state)
    end
    return true
end

local function init_camera(camera, projection_fn, near, far, zoom)
    camera.view = vmath.matrix4()
    camera.near = near == nil and DEFAULT_NEAR or near
    camera.far = far == nil and DEFAULT_FAR or far
    camera.zoom = zoom == nil and DEFAULT_ZOOM or zoom
    camera.projection_fn = projection_fn
end

local function create_predicates(...)
    local arg = {...}
    local predicates = {}
    for _, predicate_name in pairs(arg) do
        predicates[predicate_name] = render.predicate({predicate_name})
    end
    return predicates
end

local function create_camera(state, name, is_main_camera)
    local camera = {}
    camera.options = {}
    state.cameras[name] = camera
    if is_main_camera then
        state.main_camera = camera
    end
    return camera
end

local function create_state()
    local state = {}
    local color = vmath.vector4(0, 0, 0, 0)
    color.x = sys.get_config_number("render.clear_color_red", 0)
    color.y = sys.get_config_number("render.clear_color_green", 0)
    color.z = sys.get_config_number("render.clear_color_blue", 0)
    color.w = sys.get_config_number("render.clear_color_alpha", 0)
    state.clear_buffers = {
        [graphics.BUFFER_TYPE_COLOR0_BIT] = color,
        [graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
        [graphics.BUFFER_TYPE_STENCIL_BIT] = 0
    }
    state.cameras = {}
    return state
end

local function set_camera_world(state)
    local camera_components = camera.get_cameras()

    -- This will set the last enabled camera from the stack of camera components
    if #camera_components > 0 then
        for i = #camera_components, 1, -1 do
            if camera.get_enabled(camera_components[i]) then
                local camera_component = state.cameras.camera_component
                camera_component.camera = camera_components[i]
                render.set_camera(camera_component.camera, { use_frustum = true })
                return camera.get_view(camera_component.camera), camera.get_projection(camera_component.camera)
            end
        end
    end

    -- If no active camera was found, we use the default main "camera world" camera
    local camera_world = state.cameras.camera_world
    render.set_view(camera_world.view)
    render.set_projection(camera_world.proj)
    return camera_world.view, camera_world.proj
end

local function reset_camera_world(state)
    -- unbind the camera if a camera component is used
    if state.cameras.camera_component.camera then
        state.cameras.camera_component.camera = nil
        render.set_camera()
    end
end

local function draw_world(predicates, view, projection, viewport_width, viewport_height, mirrored)
    local draw_options = {
        frustum = projection * view,
        frustum_planes = render.FRUSTUM_PLANES_ALL,
        sort_order = render.SORT_FRONT_TO_BACK,
    }

    -- Explicit matrices are shared by the screen and all capture passes.
    render.set_camera()
    render.set_viewport(0, 0, viewport_width, viewport_height)
    render.set_view(view)
    render.set_projection(projection)

    -- Fill the background without modifying depth, including inside probes.
    -- No culling: the camera views the cube from inside.
    render.disable_state(graphics.STATE_BLEND)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.set_depth_mask(false)
    render.draw(predicates.skybox)

    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_depth_mask(true)
    render.disable_state(graphics.STATE_BLEND)
    render.set_cull_face(mirrored and graphics.FACE_TYPE_FRONT or graphics.FACE_TYPE_BACK)
    render.draw(predicates.model, draw_options)
    if not mirrored then
        render.draw(predicates.planar_reflection, draw_options)
    end
    render.disable_state(graphics.STATE_CULL_FACE)

    render.set_depth_mask(false)
    render.enable_state(graphics.STATE_BLEND)
    render.draw(predicates.tile, draw_options)
    render.draw(predicates.particle)
    render.disable_state(graphics.STATE_BLEND)
    render.disable_state(graphics.STATE_DEPTH_TEST)
end

function init(self)
    self.planar_constants = render.constant_buffer()
    self.planar_reflection_enabled = false
    self.planar_plane = vmath.vector4(0, 1, 0, 0)
    self.planar_strength = 0.4
    self.predicates = create_predicates("tile", "gui", "particle", "model", "skybox", "planar_reflection", "debug_text")

    -- default is stretch projection. copy from builtins and change for different projection
    -- or send a message to the render script to change projection:
    -- msg.post("@render:", "use_stretch_projection", { near = -1, far = 1 })
    -- msg.post("@render:", "use_fixed_projection", { near = -1, far = 1, zoom = 2 })
    -- msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })

    local state = create_state()
    self.state = state

    local camera_world = create_camera(state, "camera_world", true)
    init_camera(camera_world, get_stretch_projection)
    local camera_gui = create_camera(state, "camera_gui")
    init_camera(camera_gui, get_gui_projection)
    -- Create a special camera that wraps camera components (if they exist)
    -- It will take precedence over any other camera, and not change from messages
    local camera_component = create_camera(state, "camera_component")
    update_state(state)

    -- Fake Real Glass integration:
    -- 1. add the back-face override material to the .render file as "glass_backface_override"
    -- 2. keep glass models tagged with the "glass" material tag
    -- 3. call the module after drawing the opaque world and before GUI
    self.fake_glass = fake_real_glass.create({
        backface_material = "glass_backface_override",
    })
    self.shared_glass_enabled = true
    self.sphere_glass = {}
end

function update(self)
    local state = self.state
    if not state.valid then
        if not update_state(state) then
            return
        end
    end

    local predicates = self.predicates
    -- clear screen buffers
    --
    -- turn on depth_mask before `render.clear()` to clear it as well
    render.set_depth_mask(true)
    render.set_stencil_mask(0xff)
    render.clear(state.clear_buffers)

    -- setup camera view and projection
    --
    local world_view, world_projection = set_camera_world(state)

    -- draw the opaque world normally
    draw_world(predicates, world_view, world_projection, state.window_width, state.window_height)

    -- Fake Real Glass integration:
    -- this captures the opaque scene/back faces and draws the glass front faces.
    self.sphere_glass = self.sphere_glass or {}
    local glass_states = {}
    if self.shared_glass_enabled ~= false then glass_states[#glass_states + 1] = self.fake_glass end
    for _, tag in ipairs({ "glass_sphere_left", "glass_sphere_right" }) do
        if self.sphere_glass[tag] then
            glass_states[#glass_states + 1] = self.sphere_glass[tag]
        end
    end
    for _, glass_state in ipairs(glass_states) do
        fake_real_glass.draw(glass_state, {
            view = world_view,
            projection = world_projection,
            window_width = state.window_width,
            window_height = state.window_height,
            clear_buffers = state.clear_buffers,
            draw_world = function(view, projection, viewport_width, viewport_height)
                draw_world(predicates, view, projection, viewport_width, viewport_height)
            end,
        })
    end

    if self.planar_reflection_enabled then
        local width, height = state.window_width, state.window_height
        if not self.planar_rt or self.planar_width ~= width or self.planar_height ~= height then
            if self.planar_rt then render.delete_render_target(self.planar_rt) end
            self.planar_rt = render.render_target({
                [graphics.BUFFER_TYPE_COLOR0_BIT] = {
                    format = graphics.TEXTURE_FORMAT_RGBA16F, width = width, height = height,
                    min_filter = graphics.TEXTURE_FILTER_LINEAR, mag_filter = graphics.TEXTURE_FILTER_LINEAR,
                    u_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE, v_wrap = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
                },
                [graphics.BUFFER_TYPE_DEPTH_BIT] = {
                    format = graphics.TEXTURE_FORMAT_DEPTH, width = width, height = height,
                },
            })
            self.planar_width, self.planar_height = width, height
        end
        -- Reflect across n.x + d = 0; normalize the supplied plane.
        local p = self.planar_plane
        local length = math.sqrt(p.x * p.x + p.y * p.y + p.z * p.z)
        local x, y, z, d = p.x / length, p.y / length, p.z / length, p.w / length
        local mirror = vmath.matrix4()
        mirror.m00, mirror.m01, mirror.m02 = 1 - 2*x*x, -2*x*y, -2*x*z
        mirror.m10, mirror.m11, mirror.m12 = -2*y*x, 1 - 2*y*y, -2*y*z
        mirror.m20, mirror.m21, mirror.m22 = -2*z*x, -2*z*y, 1 - 2*z*z
        mirror.m03, mirror.m13, mirror.m23 = -2*d*x, -2*d*y, -2*d*z
        local mirror_view = world_view * mirror
        render.set_render_target(self.planar_rt)
        render.set_depth_mask(true)
        render.clear(state.clear_buffers)
        draw_world(predicates, mirror_view, world_projection, width, height, true)
        for _, glass_state in ipairs(glass_states) do
            fake_real_glass.draw(glass_state, {
                view = mirror_view, projection = world_projection,
                window_width = width, window_height = height, clear_buffers = state.clear_buffers,
                output_target = self.planar_rt, capture_probe = false, flip_culling = true,
                draw_world = function(view, projection, w, h)
                    draw_world(predicates, view, projection, w, h, true)
                end,
            })
        end
        render.set_render_target(render.RENDER_TARGET_DEFAULT)
        render.set_viewport(0, 0, width, height)
        render.set_view(world_view)
        render.set_projection(world_projection)
        render.enable_state(graphics.STATE_DEPTH_TEST)
        render.set_depth_func(graphics.COMPARE_FUNC_LEQUAL)
        render.set_depth_mask(true)
        render.disable_state(graphics.STATE_BLEND)
        render.enable_state(graphics.STATE_CULL_FACE)
        render.set_cull_face(graphics.FACE_TYPE_BACK)
        self.planar_constants.reflection_view_proj = world_projection * mirror_view
        self.planar_constants.reflection_params = vmath.vector4(1 / width, 1 / height, self.planar_strength, 1)
        render.enable_texture("planar_reflection", self.planar_rt, graphics.BUFFER_TYPE_COLOR0_BIT)
        render.draw(predicates.planar_reflection, { constants = self.planar_constants })
        render.disable_texture("planar_reflection")
        render.set_depth_func(graphics.COMPARE_FUNC_LESS)
        render.disable_state(graphics.STATE_CULL_FACE)
        render.disable_state(graphics.STATE_DEPTH_TEST)
    end

    render.draw_debug3d()

    reset_camera_world(state)

    -- render GUI
    --
    local camera_gui = state.cameras.camera_gui
    render.set_view(camera_gui.view)
    render.set_projection(camera_gui.proj)

    render.enable_state(graphics.STATE_STENCIL_TEST)
    render.draw(predicates.gui, camera_gui.options)
    render.draw(predicates.debug_text, camera_gui.options)
    render.disable_state(graphics.STATE_STENCIL_TEST)
    render.disable_state(graphics.STATE_BLEND)
end

function final(self)
    fake_real_glass.final(self.fake_glass)
    for _, glass in pairs(self.sphere_glass or {}) do fake_real_glass.final(glass) end
    if self.planar_rt then render.delete_render_target(self.planar_rt) end
end

function on_message(self, message_id, message)
    local state = self.state
    local camera = state.main_camera

    if message_id == hash("enable_shared_glass") then
        self.shared_glass_enabled = message.enabled ~= false
        if not self.shared_glass_enabled then fake_real_glass.final(self.fake_glass) end
        return
    end

    if message_id == hash("set_sphere_probe") then
        self.sphere_glass = self.sphere_glass or {}
        local glass = self.sphere_glass[message.tag]
        if not glass then
            glass = fake_real_glass.create({
                glass_tag = message.tag, probe_position = message.position,
                probe_size = 512, probe_far = 200,
                backface_material = "glass_backface_override",
            })
            glass.sphere_refraction = true
            self.sphere_glass[message.tag] = glass
        end
        fake_real_glass.on_message(glass, hash("set_probe_position"), {
            position = message.position,
        })
        return
    end

    if message_id == hash("enable_planar_reflection") or message_id == hash("enable_floor_reflection") then
        self.planar_reflection_enabled = message.enabled ~= false
        if message.plane then
            local p = message.plane
            assert(p.x*p.x + p.y*p.y + p.z*p.z > 0, "Reflection plane requires a nonzero normal")
            self.planar_plane = p
        end
        if message.strength then self.planar_strength = message.strength end
        return
    end

    if fake_real_glass.on_message(self.fake_glass, message_id, message) then
        return
    elseif message_id == MSG_CLEAR_COLOR then
        update_clear_color(state, message.color)
    elseif message_id == MSG_WINDOW_RESIZED then
        update_state(state)
        if self.shared_glass_enabled ~= false then
            fake_real_glass.resize(self.fake_glass, state.window_width, state.window_height)
        end
    elseif message_id == MSG_SET_VIEW_PROJ then
        camera.view = message.view
        self.camera_projection = message.projection or vmath.matrix4()
        update_camera(camera, state)
    elseif message_id == MSG_SET_CAMERA_PROJ then
        camera.projection_fn = function() return self.camera_projection end
    elseif message_id == MSG_USE_STRETCH_PROJ then
        init_camera(camera, get_stretch_projection, message.near, message.far)
        update_camera(camera, state)
    elseif message_id == MSG_USE_FIXED_PROJ then
        init_camera(camera, get_fixed_projection, message.near, message.far, message.zoom)
        update_camera(camera, state)
    elseif message_id == MSG_USE_FIXED_FIT_PROJ then
        init_camera(camera, get_fixed_fit_projection, message.near, message.far)
        update_camera(camera, state)
    end
end
