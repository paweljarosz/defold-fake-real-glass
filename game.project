[bootstrap]
main_collection = /main/main.collectionc
render = /fake_real_glass/render/fake_real_glass.renderc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1
samples = 4

[android]
input_method = HiddenInputField
package = com.defold.example.basic3d

[project]
title = FakeRealGlass
version = 1.1
developer = Paweł Jarosz
publisher = Paweł Jarosz

[physics]
type = 3D

[osx]
bundle_identifier = com.defold.example.basic3d

[ios]
bundle_identifier = com.defold.example.basic3d

[html5]
scale_mode = stretch

[render]
clear_color_red = 0.25
clear_color_green = 0.27
clear_color_blue = 0.32

[library]
defold_min_version = 1.14.0
include_dirs = fake_real_glass

[light]
max_count = 8

