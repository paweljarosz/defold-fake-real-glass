name: "skybox"
tags: "skybox"
vertex_program: "/assets/materials/skybox.vp"
fragment_program: "/assets/materials/skybox.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "view" type: CONSTANT_TYPE_VIEW }
vertex_constants { name: "projection" type: CONSTANT_TYPE_PROJECTION }
samplers {
  name: "skybox"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}

fragment_constants { name: "skybox_rotation" type: CONSTANT_TYPE_USER value { x: 1.0 } }
